PORT=3000
ADMIN_TOKEN=change-me-to-a-long-random-string
HASH_SALT=change-me-too
RETENTION_DAYS=90
ENQUIRY_RETENTION_DAYS=0
RATE_LIMIT=10
TRUST_PROXY=0
AUTO_PURGE=0
SITE_ORIGIN=https://yourdomain.example

# WhatsApp: off | link | api | auto (auto switches Cloud API handling on past the threshold)
WA_MODE=link
WA_API_THRESHOLD=150
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0

# Email notifications (optional; Gmail SMTP or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=kandelakulture@gmail.com
SMTP_PASS=your-app-password-here
ADMIN_EMAIL=kandelakulture@gmail.com
